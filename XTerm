xterm*faceSize: 15

xterm*faceName: Inconsolata

!nice fonts:
!xterm*faceName: Liberationmono
!xterm*faceName: DejaVuSansMono
!xterm*faceName: Hack

!xterm*faceName: NotoMono

XTerm*vt100.translations: #override \
    Shift Ctrl <Key> C: copy-selection(CLIPBOARD) \n\
    Shift Ctrl <Key> V: insert-selection(CLIPBOARD)

xterm*background: black

xterm*allowBoldFonts: false
!xterm*allowBoldFonts: true

!darkest-grey font color:
!xterm*foreground: rgb:40/40/40

!dark-dark grey font color:
xterm*foreground: #505050

!dark-grey font color:
!xterm*foreground: rgb:66/66/66

!xterm*colorMode: false
xterm*colorMode: true

xterm*cursorBlock: true
xterm*geometry:70x15

!xterm*selectToClipboard: true
XTerm*VT100.Translations:       #override\n\
 Shift Ctrl <KeyPress> v: insert-selection(CLIPBOARD)\n\
 Shift Ctrl <KeyPress> c: copy-selection(CLIPBOARD)\n
