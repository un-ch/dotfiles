xterm*faceSize: 13

!xterm*faceName: Notosansmono
!xterm*faceName: Luxi Mono
!xterm*faceName: Freemonooboldoblique
!xterm*faceName: Monospace
!xterm*faceName: Liberationmono
!xterm*faceName: DejaVuSansMono
